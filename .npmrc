# Use npm registry with retry logic
registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Use package-lock for more reliable installs
package-lock=true

# Fallback to public registry if needed
@fortawesome:registry=https://registry.npmjs.org/
@babel:registry=https://registry.npmjs.org/

